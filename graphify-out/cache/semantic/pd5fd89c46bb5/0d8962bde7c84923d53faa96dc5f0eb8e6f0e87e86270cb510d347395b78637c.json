{"nodes": [{"id": "repl_remote_karl_remote_repl", "label": "Karl Remote REPL (loom serve / loom connect)", "file_type": "concept", "source_file": "repl/REMOTE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain-TCP line protocol (default localhost:9000) so the session is reachable not only from `karl loom connect` but from nc, telnet or rlwrap \u2014 network transparency without a custom client requirement."}, {"id": "repl_remote_isolated_sessions", "label": "Per-Client Isolated Sessions", "file_type": "rationale", "source_file": "repl/REMOTE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple clients may connect simultaneously but each gets its own environment, so concurrent users cannot clobber one another's bindings."}, {"id": "repl_remote_no_authentication_warning", "label": "Remote REPL Has No Authentication", "file_type": "rationale", "source_file": "repl/REMOTE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server intentionally ships without auth; the documented mitigation is to bind only on trusted networks or tunnel via SSH (ssh -L 9000:localhost:9000) rather than exposing 0.0.0.0 publicly."}], "edges": [{"source": "repl_remote_karl_remote_repl", "target": "repl_readme_karl_repl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "repl/REMOTE.md", "source_location": null, "weight": 1.0}, {"source": "repl_remote_karl_remote_repl", "target": "repl_remote_isolated_sessions", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "repl/REMOTE.md", "source_location": null, "weight": 1.0}, {"source": "repl_remote_no_authentication_warning", "target": "repl_remote_karl_remote_repl", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score