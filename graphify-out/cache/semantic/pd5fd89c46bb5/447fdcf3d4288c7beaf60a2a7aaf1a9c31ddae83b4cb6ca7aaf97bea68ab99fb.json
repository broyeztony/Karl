{"nodes": [{"id": "specs_recoverable_broad_vs_narrow", "label": "Recoverable Errors: Broad vs Narrow", "file_type": "rationale", "source_file": "SPECS/recoverable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Making every runtime error recoverable is judged inadvisable: it blurs expected failure and programmer bugs, lets typos (unknown members) be silently recovered, and risks continuing after partial side effects. Feasible but requires grammar, evaluator and spec changes."}, {"id": "specs_recoverable_safe_accessors_proposal", "label": "Safe Accessors / get-or Helpers Proposal", "file_type": "rationale", "source_file": "SPECS/recoverable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Middle ground: keep `?` for call expressions and add explicit safe accessors (obj.get, arr.get, obj.has) or a dedicated safe member/index operator rather than making all runtime errors recoverable."}], "edges": [{"source": "specs_recoverable_broad_vs_narrow", "target": "specs_language_recover_operator", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/recoverable.md", "source_location": null, "weight": 1.0}, {"source": "specs_recoverable_broad_vs_narrow", "target": "specs_interpreter_recoverable_errors", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/recoverable.md", "source_location": null, "weight": 1.0}, {"source": "specs_recoverable_safe_accessors_proposal", "target": "specs_recoverable_broad_vs_narrow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/recoverable.md", "source_location": null, "weight": 1.0}, {"source": "specs_recoverable_safe_accessors_proposal", "target": "specs_collection_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": 