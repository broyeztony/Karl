{"nodes": [{"id": "skills_karl_api_first_stdlib_skill_karl_api_first_stdlib", "label": "Karl API-First Stdlib Skill", "file_type": "concept", "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skill for designing/reviewing Karl stdlib APIs for collections, streams, processes and runtime primitives, applied when user-land algorithms should be promoted into optimized built-ins."}, {"id": "skills_karl_api_first_stdlib_skill_api_over_userland_algorithms", "label": "Prefer API-Level Solutions Over User-Land Algorithms", "file_type": "rationale", "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users should compose high-level primitives, not re-implement textbook algorithms in app code; a repeated known algorithm is a signal to promote it into a built-in, while speculative abstractions without concrete use cases are rejected."}, {"id": "skills_karl_api_first_stdlib_skill_complexity_contract", "label": "Explicit Complexity Contracts", "file_type": "concept", "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every API states O(1)/O(log n)/O(n) targets in docs and specs, and any API claiming optimization must carry benchmark coverage proving it."}, {"id": "skills_karl_api_first_stdlib_skill_deterministic_semantics", "label": "Deterministic Semantics and Tie-Break Rules", "file_type": "concept", "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantics are specified before implementation: ordering and tie-breaking must be deterministic and null-vs-error behavior explicit, so results are reproducible and agent-predictable."}, {"id": "skills_karl_api_first_stdlib_skill_ai_ergonomics", "label": "AI-Friendly API Ergonomics", "file_type": "rationale", "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Names stay short, explicit and discoverable and return shapes small and stable, with aliases avoided \u2014 the target consumer is an AI agent that should solve tasks by composing built-ins only."}, {"id": "skills_karl_api_first_stdlib_skill_ordered_tree_search_api", "label": "Ordered Tree Search API (closest, floor, ceil, predecessor, successor, range)", "file_type": "concept", "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered trees must expose the searches users actually need at O(log n) instead of forcing them to call keys() and hand-write binary search."}, {"id": "skills_karl_api_first_stdlib_skill_node_tree_api", "label": "Hierarchical Node-Tree API (parent, children, siblings, ancestors, descendants)", "file_type": "concept", "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic hierarchy gets a dedicated API because AVL/Treap internal structure must never be exposed as stable parent/child semantics \u2014 balancing can rearrange it."}, {"id": "skills_karl_api_first_stdlib_skill_output_contract", "label": "API Proposal Output Contract", "file_type": "concept", "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every proposal must ship signatures, return shapes, complexity targets, determinism/tie rules, error/null behavior, one realistic example and a minimal test matrix."}], "edges": [{"source": "skills_karl_api_first_stdlib_skill_karl_api_first_stdlib", "target": "skills_karl_api_first_stdlib_references_api_review_checklist_api_review_checklist", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_karl_api_first_stdlib_skill_api_over_userland_algorithms", "target": "skills_karl_api_first_stdlib_skill_karl_api_first_stdlib", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_karl_api_first_stdlib_skill_karl_api_first_stdlib", "target": "skills_karl_api_first_stdlib_skill_complexity_contract", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_karl_api_first_stdlib_skill_karl_api_first_stdlib", "target": "skills_karl_api_first_stdlib_skill_deterministic_semantics", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_karl_api_first_stdlib_skill_karl_api_first_stdlib", "target": "skills_karl_api_first_stdlib_skill_ai_ergonomics", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_karl_api_first_stdlib_skill_ordered_tree_search_api", "target": "skills_karl_api_first_stdlib_skill_api_over_userland_algorithms", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/karl-api-first-stdlib/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_karl_api_first_stdlib_skill_