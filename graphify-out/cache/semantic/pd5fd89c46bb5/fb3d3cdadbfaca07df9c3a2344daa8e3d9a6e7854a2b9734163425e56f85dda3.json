{"nodes": [{"id": "agents_karl_product_context", "label": "Karl Product Context (between Bash and Go)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Karl deliberately targets the gap between Bash and Go: CLI tools, pipelines, infrastructure scripting, process orchestration and DevOps automation."}, {"id": "agents_source_of_truth", "label": "Source-of-Truth Ordering (SPECS > tests > implementation)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SPECS/ is design input, tests/ is the behavioral contract, implementation is last; semantic changes must update specs in the same change set so the three never drift."}, {"id": "agents_stream_abstraction", "label": "Stream<T> Abstraction", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streams flow; kept separate from tasks/channels/sinks so the conceptual surface stays small and semantics do not blur."}, {"id": "agents_task_abstraction", "label": "Task<T> Abstraction", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tasks compute."}, {"id": "agents_channel_abstraction", "label": "Channel<T> Abstraction", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Channels communicate."}, {"id": "agents_sink_abstraction", "label": "Sink<T> Abstraction", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sinks terminate pipelines."}, {"id": "agents_stream_model_guardrails", "label": "Stream Model Guardrails", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No push-based execution and no implicit buffering, because either would break backpressure guarantees that bound memory use."}, {"id": "agents_error_handling_model", "label": "Karl Error Handling Model", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recoverable/runtime errors get explicit recovery via `? { ... }`; stream/process execution paths stay structurally fail-fast so partial pipelines do not silently continue."}, {"id": "agents_implementation_rules", "label": "Implementation Rules for Agents", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimal change, preserve architecture, prefer simple over clever, avoid speculative features or redesigns."}, {"id": "agents_skill_sync_rule", "label": "Codex Skill Sync Requirement", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repo skills must stay synchronized with Codex global skills ($CODEX_HOME/skills) via make install-skill-hooks / make sync-skills."}, {"id": "agents_import_shorthand_rule", "label": "Single-Instance Module Import Shorthand", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer `let x = (import \"path/module.k\")()`; use two-step factory imports only when multiple independent instances are needed."}, {"id": "agents_deadlock_probe_rule", "label": "Deadlock Probe Correctness Rule", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime deadlock probing must not misclassify external-event waits (e.g. top-level signalWatch(...).recv()) as deadlocks."}, {"id": "agents_api_demo_logging_rule", "label": "One log() per API Call Demo Rule", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docs/landing/bench examples log one result per API call rather than dumping aggregated objects, because readability of demos matters more than compactness."}, {"id": "agents_design_philosophy", "label": "Karl Design Philosophy", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small conceptual surface, composable primitives, predictable runtime behavior, explicit error handling, strong streaming guarantees."}, {"id": "agents_repo_map", "label": "Repo Map", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_source_of_truth", "target": "specs_stream_execution_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_source_of_truth", "target": "specs_process_process_value", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_stream_model_guardrails", "target": "specs_stream_backpressure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weig