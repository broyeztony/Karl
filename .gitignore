# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum
.go-cache/

# env file
.env

# Editor/IDE
# .idea/
.vscode/
.DS_Store

# Playground

.playground
*.karl-new
karl

# Karl VS Code extension build artifacts
plugins/karl-vscode/node_modules/
plugins/karl-vscode/*.vsix

# Local tooling binaries
minikube-darwin-arm64

# graphify: track only the graph data + report; everything else is regenerable
# or machine-local. graph.json carries the semantic nodes, so it must stay tracked.
graphify-out/graph.html
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_*
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
