{"nodes": [{"id": "specs_language_expression_based_design", "label": "Expression-Based Language Design", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything evaluates to a value so complex operations flow into a single binding ('return to the left')."}, {"id": "specs_language_arrow_operator", "label": "`->` Single Meaning Principle", "file_type": "rationale", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`->` always means binder-to-expression, in lambdas and in case arms alike, so the syntax has no context-dependent readings."}, {"id": "specs_language_match_expression", "label": "match Expression", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One pattern-matching construct handles all branching, keeping the conceptual surface small."}, {"id": "specs_language_for_expression", "label": "for Loop Expression", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_language_recover_operator", "label": "Recover Operator `? { ... }`", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no Result/Ok/Error type; explicit failure via exit() and narrow recoverable failures via `?` keep the error model free of type ceremony."}, {"id": "specs_language_destructuring", "label": "Destructuring and Structural Patterns", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_language_object_vs_map", "label": "Object vs Map Distinction", "file_type": "rationale", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Objects are fixed identifier-keyed shapes; Maps carry dynamic keys. Object keys must be identifiers so shapes stay statically readable."}, {"id": "specs_language_concurrency_expressions", "label": "Concurrency Expressions (&, spawn, !&, race)", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_language_imports", "label": "Import Expressions and Module Factory", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No export keyword yet: all top-level lets are exported, and name collisions are the caller's responsibility."}, {"id": "specs_language_query_expressions", "label": "SQL-like Query Expressions (from/where/orderby/select)", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_language_grammar_ebnf", "label": "Minimal Grammar (EBNF)", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_language_disambiguation_rules", "label": "Block vs Object Disambiguation Rules", "file_type": "rationale", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`{` starts a block by default; it is an object literal only when empty, containing a top-level `:`, a spread, or a trailing comma. Shorthand-only objects need the trailing comma precisely to break this ambiguity. Newlines are whitespace and never terminate statements."}, {"id": "specs_language_pipeline_operator", "label": "Pipeline Operator `|` in Grammar", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`|` is placed between logic_or and logic_and in precedence and is type-checked at runtime rather than statically, because Karl has no type system."}, {"id": "specs_language_influences", "label": "Language Influences (JavaScript, Scala, Go)", "file_type": "rationale", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JavaScript for prototyping speed and JSON-like data, Scala for expression-oriented pattern matching, Go for concurrency as a language primitive (adapted to an event-loop model)."}, {"id": "specs_language_future_work", "label": "Language Future Work (for-in, type annotations)", "file_type": "concept", "source_file": "SPECS/language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_language_expression_based_design", "target": "specs_language_arrow_operator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/language.md", "source_location": null, "weight": 1.0}, {"source": "specs_language_expression_based_design", "target": "specs_language_match_expression", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/language.md", "source_location": null, "weight": 1.0}, {"source": "specs_language_expression_based_design", "target": "specs_language_for_expression", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/language.md", "source_location": null, "weight":