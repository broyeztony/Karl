{"nodes": [{"id": "specs_stream_pipeline_operator", "label": "Stream Pipeline Operator `|`", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`|` is reserved exclusively for stream pipelines; left operands must be sources/plans/readers/<process>, right operands stages or sinks, validated at runtime."}, {"id": "specs_stream_execution_model", "label": "Stream Execution Model (sink-triggered, lazy)", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "source | stage builds a lazy immutable plan; nothing runs until a terminal consumer applies, and sink execution blocks the current task unless wrapped in &/spawn."}, {"id": "specs_stream_dag_model", "label": "Stream DAG Model", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Today every pipeline expression is a linear DAG path, giving deterministic dataflow while leaving room for richer operators; tee/broadcast forking is not yet first-class, so complex topologies are composed with Task and Channel primitives."}, {"id": "specs_stream_backpressure", "label": "Stream Backpressure (pull-driven)", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demand originates at the sink, so a slow sink slows upstream stages and the source and memory stays bounded by stage/buffer strategy."}, {"id": "specs_stream_sources", "label": "Stream Sources (read/stdin/http/fromChannel/merge/zip/join)", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_stream_stages", "label": "Stream Stages (lines/map/filter/window/throttle/tee/spill...)", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_stream_sinks", "label": "Stream Sinks (stdout/write/collect/reduce/partition/exec...)", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_stream_partition_sink", "label": "partition(...) Branching Sink", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Branch sources are single-consumer and unconsumed branches are dropped by policy, so an unopened branch cannot block the upstream pipeline."}, {"id": "specs_stream_reader_writer", "label": "Low-level <stream-reader> / <stream-writer>", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_stream_members", "label": "Stream Member Reads (s.read()/s.close())", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "read() is stateful per stream value instance with one lazily-opened cursor and no implicit restart after EOF; concurrent read() on the same instance is a recoverable stream_state error."}, {"id": "specs_stream_error_model", "label": "Stream Error Model and Recoverable Kinds", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structural fail-fast: a failing source/stage/sink terminates the current pipeline execution rather than skipping items."}, {"id": "specs_stream_stdio_constants", "label": "Stdio/Type Constants (PIPE/INHERIT/NULL/TEXT/BYTES)", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_stream_process_integration", "label": "Stream/Process Integration Points", "file_type": "concept", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "<process> is accepted directly as a stream source shorthand for its piped stdout, so `p | lines() | collect()` works without reaching into p.stdout."}, {"id": "specs_stream_wasm_limitation", "label": "Stream WASM Runtime Limitation", "file_type": "rationale", "source_file": "SPECS/stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In the browser runtime low-level stream/file APIs may be unavailable and return recoverable stream errors instead of hard-failing."}], "edges": [{"source": "specs_stream_pipeline_operator", "target": "specs_stream_execution_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/stream.md", "source_location": null, "weight": 1.0}, {"source": "specs_stream_execution_model", "target": "specs_stream_backpressure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/stream.md", "source_location": null, "weight": 1.0}, {"source": "specs_stream_dag_model", "target": "specs_stream_execution_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/stream.md", "source_location": null, "weight": 1.0}, {"source": "specs_stream_dag_model", "target": "agents_task_abstraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/stream.md"