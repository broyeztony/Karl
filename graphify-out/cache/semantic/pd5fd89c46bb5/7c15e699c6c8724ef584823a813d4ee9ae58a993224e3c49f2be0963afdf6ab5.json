{"nodes": [{"id": "specs_collection_design_goals", "label": "Collection Design Goals", "file_type": "rationale", "source_file": "SPECS/collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collections must be useful for real programs, explicit about asymptotic behavior, predictable across CLI/REPL/bench, and composable with Karl expression style."}, {"id": "specs_collection_array", "label": "Array Collection", "file_type": "concept", "source_file": "SPECS/collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_collection_map", "label": "Map Collection", "file_type": "concept", "source_file": "SPECS/collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_collection_set", "label": "Set Collection", "file_type": "concept", "source_file": "SPECS/collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_collection_tree", "label": "Ordered Index Tree tree(kind?)", "file_type": "concept", "source_file": "SPECS/collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AVL/treap ordered index giving O(log n) lookup and bounds; keys must be homogeneous ordered scalars because mixed key domains have no total order."}, {"id": "specs_collection_ntree", "label": "Hierarchical Node Tree ntree(...)", "file_type": "concept", "source_file": "SPECS/collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate type exists because ordered trees rebalance internally, so their parent/child links are implementation artifacts; exposing them would be unstable and misleading. ntree keeps parent/children as user-level semantics with stable node identity."}, {"id": "specs_collection_error_semantics", "label": "Collection Error Semantics", "file_type": "rationale", "source_file": "SPECS/collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invalid argument types and invalid key-domain transitions are runtime errors; missing keys return null/false rather than panicking, and no host-language panic may escape."}, {"id": "specs_collection_naming_rules", "label": "Collection Naming Rules", "file_type": "rationale", "source_file": "SPECS/collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered-tree search vocabulary (floor/ceil/predecessor/successor/closest) stays distinct from hierarchy vocabulary (parent/children/siblings/ancestors/descendants); aliases require explicit approval."}], "edges": [{"source": "specs_collection_tree", "target": "specs_collection_design_goals", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/collection.md", "source_location": null, "weight": 1.0}, {"source": "specs_collection_ntree", "target": "specs_collection_tree", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "SPECS/collection.md", "source_location": null, "weight": 1.0}, {"source": "specs_collection_error_semantics", "target": "specs_interpreter_recoverable_errors", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/collection.md", "source_location": null, "weight": 1.0}, {"source": "specs_collection_naming_rules", "target": "specs_tooling_naming_naming_system", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "SPECS/collection.md", "source_location": null, "weight": 1.0}, {"source": "specs_collection_map", "target": "sp