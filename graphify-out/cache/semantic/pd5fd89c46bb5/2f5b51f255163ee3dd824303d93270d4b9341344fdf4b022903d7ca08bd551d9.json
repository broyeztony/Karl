{"nodes": [{"id": "specs_interpreter_runtime_value_model", "label": "Runtime Value Model", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_interpreter_environment_scope", "label": "Environment and Lexical Scope", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_interpreter_truthy_falsy", "label": "Truthy/Falsy Semantics", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python-style: null/false/0/0.0/\"\"/[]/{}/empty map/set/tree are falsy; logical operators return Bool rather than the operand."}, {"id": "specs_interpreter_for_semantics", "label": "For-Expression Evaluation Algorithm", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loop-state updates are explicit in the body; `continue` must preserve progress or the loop may not terminate. `break` with no value runs `then`; `break expr` bypasses it."}, {"id": "specs_interpreter_partial_application", "label": "Partial Application with `_`", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_interpreter_slice_semantics", "label": "Slice Semantics (half-open, rune-based)", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_interpreter_query_expressions", "label": "Query Expression Execution", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_interpreter_import_factory", "label": "Import Factory and Live Module Object", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`import` returns a zero-arg factory so each call yields a fresh module instance; the returned object is a live view of the module environment. Programs are parsed once and cached, then evaluated per call."}, {"id": "specs_interpreter_recoverable_errors", "label": "Recoverable Errors (`?`) Runtime Semantics", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`?` now applies to any expression and catches both RecoverableError and RuntimeError, binding `error` as { kind, message }. exit(), parse errors and control-flow misuse stay uncatchable so hard stops remain hard."}, {"id": "specs_interpreter_task_failure_policy", "label": "Task Failure Policy (fail-fast / defer)", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Errors are stored on the task handle and surface on wait; unobserved detached failures fail the run fast by default, with defer reporting them at program end."}, {"id": "specs_interpreter_cancellation", "label": "Cooperative Cancellation", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancellation takes effect only at yield points (wait/send/recv/sleep/http); awaiting a canceled task raises a recoverable error with kind = \"canceled\"."}, {"id": "specs_interpreter_pattern_matching", "label": "Pattern Matching Semantics", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tuples are represented as arrays and there is no tuple literal, so tuple patterns are just fixed-length array patterns. Call patterns are unsupported."}, {"id": "specs_interpreter_event_loop", "label": "Event Loop Runtime Architecture", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target model is a single-threaded cooperative scheduler with no preemption and CSP-style rendezvous messaging; the current Go implementation uses goroutines instead."}, {"id": "specs_interpreter_yield_points", "label": "Yield Points", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only wait, ch.send, ch.recv and sleep yield; everything else is synchronous, so a task that never yields monopolizes the loop."}, {"id": "specs_interpreter_spawn_and_wait", "label": "Spawn and Wait (& / spawn, join task)", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Group spawns create a hidden join task that collects child results in input order, so `& { A(), B(), C() }` yields [A, B, C] deterministically despite nondeterministic scheduling."}, {"id": "specs_interpreter_race", "label": "Race (!& / race)", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hidden race task returns the first completed child result and requests cancellation of the losers; a loser that never yields runs to completion but its result is discarded."}, {"id": "specs_interpreter_rendezvous", "label": "Rendezvous Channel Runtime", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unbuffered by default with a closed flag; send blocks until a receiver accepts, recv returns [value, done], and sending on a closed rendezvous is a hard runtime error."}, {"id": "specs_interpreter_system_primitives", "label": "System Primitives (argv/env/environ/programPath/readLine)", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The runtime context snapshot is captured at evaluator startup and shared by spawned tasks and imported modules, so argv/environ stay stable across a run."}, {"id": "specs_interpreter_builtin_functions", "label": "Built-in Function Surface", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_interpreter_equality_semantics", "label": "Equality Semantics (== identity, eqv structural)", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "== is identity for composites and eqv is deep for arrays/objects/maps; mixed-type comparison is always false because there is no implicit coercion."}, {"id": "specs_interpreter_member_call_desugaring", "label": "Member Call Desugaring (no implicit receiver)", "file_type": "concept", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dot-calls on built-in collections are pure syntax sugar (list.map(fn) -> map(list, fn)); user-defined objects get no implicit receiver so functions must take the object explicitly."}, {"id": "specs_interpreter_known_limitations", "label": "Interpreter Known Limitations", "file_type": "rationale", "source_file": "SPECS/interpreter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct AST evaluator with no bytecode/JIT, goroutine-backed tasks with nondeterministic scheduling, eager range allocation, and no tail-call optimization."}], "edges": [{"source": "specs_interpreter_runtime_value_model", "target": "specs_language_expression_based_design", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/interpreter.md", "source_location": null, "weight": 1.0}, {"source": "specs_interpreter_recoverable_errors", "target": "specs_language_recover_operator", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/interpreter.md", "source_location": null, "weight": 1.0}, {"source": "specs_interpreter_query_expressions", "target": "specs_language_query_expressions", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/interpreter.md", "source_location": null, "weight": 1.0}, {"source": "specs_interpreter_import_factory", "target": "specs_language_imports", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/interpreter.md", "source_location": null, "weight": 1.0}, {"source": "specs_interpreter_for_semantics", "target": "specs_language_for_expression", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/interpreter.md", "source_location": null, "weight": 1.0}, {"source": "specs_interpreter_pattern_matching", "target": "specs_language_match_expression", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPECS/interpreter.